# ─────────────────────────────────────────────
#  Kareena VA  —  Environment Configuration
#  Copy this file to .env and fill in your values
#  Never commit .env to version control
# ─────────────────────────────────────────────

# ── LM Studio (local primary model) ──────────
# Start LM Studio, load "Spark X2.5 4B GGUF Q4_K_M", then
# go to Local Server and click Start Server.
# The default address is shown below.
LM_STUDIO_BASE_URL=http://localhost:1234/v1/
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=spark-x2.5-4b

# ── Gemini API (cloud fallback model) ────────
# Get your free API key at https://aistudio.google.com/apikey
# The free tier gives access to gemma-4-31b-it at no cost.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemma-4-31b-it

# ── Agent behaviour ───────────────────────────
# Max tool-call rounds the agent can do per query before giving up
AGENT_MAX_ITERATIONS=5

# ── Filesystem tool ───────────────────────────
# The agent is only allowed to read/write inside this directory.
# Defaults to the project folder if left blank.
AGENT_FS_ROOT=src
